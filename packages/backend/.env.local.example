# Hosted selection is generated by `convex dev` after signing in.
# Do not copy placeholder deployment identifiers into a working project.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Configure the following SERVER variables in the Convex deployment dashboard.
# Setting them here does not configure hosted functions.
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.example
# GEMINI_API_KEY=<private-google-ai-studio-key>
# GEMINI_MODEL=gemini-3.6-flash

# Optional explicit AI locale allowlist; default en,hi,pa. Registry presence is not evidence.
# AI_CHAT_LOCALES=en,hi,pa
