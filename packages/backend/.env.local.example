# Hosted selection is generated by `convex dev` after signing in.
# Do not copy placeholder deployment identifiers into a working project.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Configure the following SERVER variables in the Convex deployment dashboard.
# Setting them here does not configure hosted functions.
