PORT=5000
MONGO_URI=your_mongo_connection

# LLM provider switch: gateway | gemini
LLM_PROVIDER=gateway
# gateway: MIET-issued token (e.g. dgx_...). gemini: Google AI key (AIza...) only if LLM_PROVIDER=gemini
LLM_API_KEY=your_gateway_or_gemini_api_key
LLM_MODEL=qwen3:latest
LLM_API_URL=/gateway/llm/chat
LLM_API_KEY_HEADER=Authorization
LLM_API_KEY_PREFIX=Bearer

# For college-hosted gateway routes
GATEWAY_BASE_URL=https://ai-services.mietjmu.in

# Gemini configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro
LLM_FALLBACK_MODE=rule_based

# Optional payment
RAZORPAY_KEY=your_key
RAZORPAY_SECRET=your_secret

# Scraper input (comma-separated listing URLs)
SCRAPE_URLS=https://example.com/lawyers
SCRAPE_MAX_PAGES=3
SCRAPE_PROFILE_DEPTH=10
SCRAPE_DRY_RUN=false
